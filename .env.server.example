# 部署服务器：项目代码和模型均在服务器本地。
APP_ENV=production
MODEL_BACKEND=local
MODEL_SERVICE_ENABLED=false
MODEL_SERVICE_HOST=127.0.0.1
MODEL_SERVICE_PORT=19000

# 以下路径仅为占位示例，必须由服务器负责人填写实际已部署的模型目录。
QWEN_MODEL_PATH=/opt/deep-sea-explorer/models/qwen
# This deployment does not require image generation. Enable it only with a compatible SDXL model path.
IMAGE_GENERATION_ENABLED=false
IMAGE_MODEL_PATH=
MEMO_EMBEDDING_MODEL_PATH=/opt/deep-sea-explorer/models/gte
RAG_EMBEDDING_MODEL_PATH=/opt/deep-sea-explorer/models/minilm

# Nginx is the only public endpoint; keep internal Flask/Gunicorn services private.
API_HOST=127.0.0.1
API_PORT=9001
SPEECH_HOST=127.0.0.1
SPEECH_PORT=9009
# Must be writable by the deepsea service user. The supplied systemd units
# permit writes only below this directory.
TEMP_DIR=/var/lib/deep-sea-explorer
REPORT_FONT_PATH=
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:19100,http://localhost:19100
MAX_CONTENT_LENGTH_MB=50
MEMO_SIMILARITY_THRESHOLD=0.85
MODEL_MAX_CONCURRENT_REQUESTS=1
MODEL_MAX_QUEUE_SIZE=4
MODEL_QUEUE_TIMEOUT_SECONDS=180
MODEL_MAX_EMBEDDING_TEXTS=32
