# 通用开发机模板。复制为 .env 后按实际环境填写；不要提交 .env。
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=9001
SPEECH_HOST=0.0.0.0
SPEECH_PORT=9009

# 开发机固定使用远程模型；当前服务器协议尚未实现，默认禁用实际请求。
MODEL_BACKEND=remote
MODEL_SERVICE_ENABLED=false
MODEL_SERVICE_BASE_URL=https://model-server.example.invalid
MODEL_SERVICE_API_PREFIX=/v1
MODEL_SERVICE_AUTH_TYPE=bearer
MODEL_SERVICE_AUTH_TOKEN=
MODEL_SERVICE_CONNECT_TIMEOUT_SECONDS=5
MODEL_SERVICE_READ_TIMEOUT_SECONDS=120
MODEL_SERVICE_VERIFY_TLS=true
MODEL_SERVICE_API_VERSION=v1

# 仅服务器 local 模式填写；开发机 remote 模式必须保持为空。
QWEN_MODEL_PATH=
IMAGE_RETRIEVAL_ENABLED=false
IMAGE_RETRIEVAL_INDEX_DIR=
IMAGE_RETRIEVAL_DINO_MODEL_PATH=
IMAGE_RETRIEVAL_TOP_K=4
IMAGE_RETRIEVAL_DEVICE=auto
IMAGE_RETRIEVAL_EXCLUDE_SAME_SITE=false
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.35
SCENE_CHANGE_THRESHOLD=0.22
SCENE_CONFIRM_FRAMES=3
TRACK_CONFIRM_FRAMES=3
IMAGE_MODEL_PATH=
MEMO_EMBEDDING_MODEL_PATH=
RAG_EMBEDDING_MODEL_PATH=

TEMP_DIR=
DATA_DIR=
REPORT_FONT_PATH=
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
CORS_ORIGINS=http://localhost:8000
MAX_CONTENT_LENGTH_MB=50
MEMO_SIMILARITY_THRESHOLD=0.85
